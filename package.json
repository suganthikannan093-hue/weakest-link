{
  "name": "weakest-link",
  "version": "0.1.0",
  "private": true,
  "description": "Will my laptop reach that projector at 4K60? Adapter/cable/charger chains as a Relate graph.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:data": "python3 scripts/build_store.py",
    "test": "python3 -m unittest -v && node tests/wasm_parity.mjs",
    "test:e2e": "playwright test",
    "agent:demo": "python3 scripts/agent_demo.py",
    "agent:init": "python3 scripts/mcp_server.py init",
    "agent:docs": "python3 scripts/build_agent_docs.py"
  },
  "dependencies": {
    "@relate/relate-wasm": "1.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "vite": "^8.3.8"
  }
}
